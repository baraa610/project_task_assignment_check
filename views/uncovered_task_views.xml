<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for uncovered task alerts -->
    <record id="view_uncovered_task_alert_tree" model="ir.ui.view">
        <field name="name">uncovered.task.alert.tree</field>
        <field name="model">uncovered.task.alert</field>
        <field name="arch" type="xml">
            <tree string="Uncovered Task Alerts"
                  decoration-warning="state == 'active' and availability_status == 'busy'"
                  decoration-danger="state == 'active' and availability_status == 'on_leave'">
                <field name="create_date" string="Alert Date"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="assigned_user_id"/>
                <field name="availability_status"/>
                <field name="reason"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form view for uncovered task alerts -->
    <record id="view_uncovered_task_alert_form" model="ir.ui.view">
        <field name="name">uncovered.task.alert.form</field>
        <field name="model">uncovered.task.alert</field>
        <field name="arch" type="xml">
            <form string="Uncovered Task Alert">
                <header>
                    <button name="action_resolve" string="Resolve"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_dismiss" string="Dismiss"
                            type="object" class="btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_open_task" string="Open Task"
                            type="object" class="btn-info"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="project_id"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="availability_status"/>
                            <field name="create_date"/>
                            <field name="resolved_date" attrs="{'invisible': [('resolved_date', '=', False)]}"/>
                            <field name="resolved_by_id" attrs="{'invisible': [('resolved_by_id', '=', False)]}"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="1"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add resolution notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_uncovered_task_alert_search" model="ir.ui.view">
        <field name="name">uncovered.task.alert.search</field>
        <field name="model">uncovered.task.alert</field>
        <field name="arch" type="xml">
            <search string="Uncovered Task Alerts">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="assigned_user_id"/>
                <filter string="Active Alerts" name="active_alerts"
                        domain="[('state', '=', 'active')]"/>
                <filter string="On Leave" name="on_leave"
                        domain="[('availability_status', '=', 'on_leave')]"/>
                <filter string="Busy" name="busy"
                        domain="[('availability_status', '=', 'busy')]"/>
                <separator/>
                <filter string="Resolved" name="resolved"
                        domain="[('state', '=', 'resolved')]"/>
                <filter string="Dismissed" name="dismissed"
                        domain="[('state', '=', 'dismissed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Assigned User" name="group_user"
                            context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'availability_status'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for uncovered task alerts -->
    <record id="action_uncovered_task_alert" model="ir.actions.act_window">
        <field name="name">Uncovered Task Alerts</field>
        <field name="res_model">uncovered.task.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active_alerts': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No uncovered task alerts found
            </p>
            <p>
                Alerts are automatically created when tasks are assigned to users who are:
                <ul>
                    <li>On approved leave</li>
                    <li>Already busy with 3 or more active tasks</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_uncovered_task_alert"
              name="Uncovered Tasks"
              parent="project.menu_project_management"
              action="action_uncovered_task_alert"
              sequence="50"/>
</odoo>
